# Application Environment Configuration
APP_ENV=local
APP_NAME="Folio Library"
API_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL Connection String
DATABASE_URL=postgresql+psycopg://folio:folio_secret@postgres:5432/folio_db

# Local Host connection (when running backend outside Docker)
# DATABASE_URL=postgresql+psycopg://folio:folio_secret@localhost:5432/folio_db

# Postgres Container Credentials
POSTGRES_USER=folio
POSTGRES_PASSWORD=folio_secret
POSTGRES_DB=folio_db
POSTGRES_PORT=5432
